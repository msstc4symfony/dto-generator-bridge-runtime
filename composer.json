{
    "name": "msstc4symfony/dto-generator-bridge-runtime",
    "description": "Runtime of msstc4symfony/dto-generator-bridge: the Serializer normalizer and attribute the generated DTOs use in a Symfony application.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Maxim Shamaev",
            "email": "maxim.shamaev@gmail.com"
        }
    ],
    "keywords": [
        "openapi",
        "dto",
        "symfony",
        "serializer"
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "suggest": {
        "symfony/serializer": "The normalizer of $additionalProperties is a Serializer normalizer",
        "symfony/framework-bundle": "To register it with DtoGeneratorRuntimeBundle"
    },
    "conflict": {
        "symfony/framework-bundle": "<5.4",
        "symfony/symfony": "*"
    },
    "autoload": {
        "psr-4": {
            "Msstc4Symfony\\DtoGeneratorBridge\\Runtime\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Msstc4Symfony\\DtoGeneratorBridge\\Runtime\\Test\\": "tests/"
        }
    },
    "extra": {
        "symfony": {
            "require": "^6.4|^7.0|^8.0"
        },
        "bundle-standard": {
            "runtime": "php74"
        }
    },
    "config": {
        "sort-packages": true
    }
}
