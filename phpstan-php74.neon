# Only the bans on PHP 8 functions and classes: the package must load beside the bridge on PHP 7.4, and phpVersion 70400 in
# phpstan.dist.neon does not catch what exists in the analysing runtime. Run on PHP 8.4 by the "Bridge checks" job.
parameters:
    customRulesetUsed: true
    # extension-installer registers strict-rules too; the main configs run them.
    strictRules:
        allRules: false
    paths:
        - src/
        - tests/
    disallowedFunctionCalls:
        -
            function:
                - 'var_dump()'
                - 'print_r()'
                - 'dump()'
                - 'dd()'
            message: 'debug artefact'
        -
            function: 'error_log()'
            message: 'the library reports through exceptions, not the PHP error log'
        -
            function:
                - 'str_contains()'
                - 'str_starts_with()'
                - 'str_ends_with()'
                - 'array_is_list()'
                - 'get_debug_type()'
                - 'fdiv()'
                - 'preg_last_error_msg()'
                - 'get_resource_id()'
                - 'enum_exists()'
                - 'fsync()'
                - 'fdatasync()'
                - 'json_validate()'
                - 'mb_str_pad()'
                - 'str_increment()'
                - 'str_decrement()'
                - 'array_find()'
                - 'array_find_key()'
                - 'array_any()'
                - 'array_all()'
                - 'mb_trim()'
                - 'mb_ltrim()'
                - 'mb_rtrim()'
                - 'mb_ucfirst()'
                - 'mb_lcfirst()'
                - 'array_first()'
                - 'array_last()'
                - 'memory_reset_peak_usage()'
                - 'ini_parse_quantity()'
                - 'fpow()'
                - 'http_get_last_response_headers()'
                - 'http_clear_last_response_headers()'
                - 'request_parse_body()'
                - 'grapheme_str_split()'
                - 'bcdivmod()'
                - 'get_error_handler()'
                - 'get_exception_handler()'
            message: 'PHP 8.0+ only; the package runs on PHP 7.4 (phpVersion: 70400 does not catch functions present in the analysing runtime)'
    disallowedClasses:
        -
            class:
                - 'ValueError'
                - 'PhpToken'
                - 'UnhandledMatchError'
                - 'Fiber'
                - 'ReturnTypeWillChange'
                - 'UnitEnum'
                - 'BackedEnum'
                - 'ReflectionEnum'
                - 'ReflectionUnionType'
                - 'ReflectionIntersectionType'
                - 'SensitiveParameter'
                - 'AllowDynamicProperties'
                - 'Override'
                - 'Deprecated'
                - 'Random\Randomizer'
                - 'DateMalformedStringException'
            message: 'PHP 8.0+ only; the package runs on PHP 7.4'
        -
            class: 'WeakMap'
            message: 'PHP 8.0+ only; the package runs on PHP 7.4'
            # Only as the bundle's test for PHP 8.0, through class_exists().
            allowIn:
                - '*/src/Bundle/DependencyInjection/Normalizers.php'
        -
            class: 'Attribute'
            message: 'PHP 8.0+ only; the package runs on PHP 7.4'
            # Only in #[...], which PHP 7.4 reads as a comment; the runtime classes themselves need PHP 8.0.
            allowIn:
                - '*/src/AdditionalProperties.php'
        -
            class: 'Stringable'
            message: 'PHP 8.0+ only; the package runs on PHP 7.4'
